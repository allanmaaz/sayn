{
  "name": "sayn-desktop-windows",
  "version": "1.1.0",
  "description": "SAYN — AI Voice Assistant & Smart Writing Studio for Windows (Wispr Flow + QuillBot + Grammarly)",
  "main": "src/main.js",
  "author": "SAYN Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --ia32",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.sayn.desktop.windows",
    "productName": "SAYN",
    "directories": {
      "output": "../../release/windows"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64", "ia32"]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SAYN",
      "artifactName": "SAYN-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "SAYN-Portable-${version}-${arch}.${ext}"
    },
    "files": [
      "src/**/*",
      "resources/**/*",
      "dist/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
