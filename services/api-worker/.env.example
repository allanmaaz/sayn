# Cloudflare Worker Environment Configuration
ENVIRONMENT=development
DEFAULT_AI_PROVIDER=gemini # Options: gemini, openai, groq, workers-ai

# Supabase Auth Integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Provider API Keys (Set at least one in Cloudflare secrets via `wrangler secret put <KEY>`)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
